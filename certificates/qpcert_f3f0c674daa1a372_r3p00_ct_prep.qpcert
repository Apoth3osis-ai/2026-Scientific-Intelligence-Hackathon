d\":\"g33\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"t\",\"kind\":\"gate\",\"op_id\":\"g34\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"h\",\"kind\":\"gate\",\"op_id\":\"g35\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"s\",\"kind\":\"gate\",\"op_id\":\"g36\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"t\",\"kind\":\"gate\",\"op_id\":\"g37\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"h\",\"kind\":\"gate\",\"op_id\":\"g38\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"t\",\"kind\":\"gate\",\"op_id\":\"g39\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"h\",\"kind\":\"gate\",\"op_id\":\"g40\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"t\",\"kind\":\"gate\",\"op_id\":\"g41\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"h\",\"kind\":\"gate\",\"op_id\":\"g42\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"t\",\"kind\":\"gate\",\"op_id\":\"g43\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"h\",\"kind\":\"gate\",\"op_id\":\"g44\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[],\"gate\":\"sdg\",\"kind\":\"gate\",\"op_id\":\"g45\",\"parameters\":[],\"targets\":[\"q1\"]},{\"controls\":[\"q0\"],\"gate\":\"cx\",\"kind\":\"gate\",\"op_id\":\"g46\",\"parameters\":[],\"targets\":[\"q1\"]}],\"qubits\":[{\"id\":\"q0\"},{\"id\":\"q1\"}],\"schema\":\"heyting.quantum_circuit_ir.v1\",\"semantic_profile\":\"exact_clifford_t_v2\"}","media_type":"application/json","path":"circuit/circuit.qcir.json","sha256":"af6505a06b006fe222a0e0b0eb76e4cf87056278a144327baa8361fb120b041a"},{"byte_length":4798,"content":"{\"circuit_subject_sha256\":\"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a\",\"claims\":[{\"accepted_evidence_tiers\":[\"kernel_certified\",\"checker_verified\"],\"claim_id\":\"r3p00_ct_prep_well_formed\",\"description\":\"The LiH 3.0 Angstrom Clifford+T state-preparation circuit is admitted by the exact Clifford+T profile.\",\"statement\":{\"claim_type\":\"well_formed\",\"profile\":\"exact_clifford_t_v2\"}},{\"accepted_evidence_tiers\":[\"kernel_certified\",\"checker_verified\"],\"claim_id\":\"r3p00_ct_prep_action\",\"description\":\"The exact D[omega] matrix of the circuit is recomputed and proven unitary; its quotient forgets only unit global phase.\",\"statement\":{\"claim_type\":\"circuit_property\",\"parameters\":{},\"predicate\":{\"name\":\"exact_unitary_action\",\"namespace\":\"HeytingLean.Quantum.ProofCarrying\",\"version\":\"v1\"},\"relation\":\"same_unitary_up_to_global_phase\"}}],\"evidence\":[{\"artifacts\":[{\"media_type\":\"text/x-lean\",\"path\":\"proof/Generated.lean\",\"role\":\"lean_source\",\"sha256\":\"1f80c9a90c7030f529681137aefb487ec8a9b551d3c4dbcbb9146b5cdda74f48\"},{\"media_type\":\"application/json\",\"path\":\"proof/axiom_probe.json\",\"role\":\"axiom_probe\",\"sha256\":\"55565378188c9544067acbd3d4e8037cdf1255ec038bb19a65636dfe4e93cc04\"},{\"media_type\":\"application/json\",\"path\":\"proof/dependency_manifest.json\",\"role\":\"kernel_dependency_manifest\",\"sha256\":\"e87a77dcb0890f02235d37157143a36e24e321c5da103886dfa37c0d75359f10\"},{\"media_type\":\"text/plain\",\"path\":\"environment/lean-toolchain\",\"role\":\"lean_toolchain\",\"sha256\":\"42779d67b81608af8a12aa4328d2ab47ca201925b3b2bd68369587b5340bb434\"}],\"circuit_subject_sha256\":\"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a\",\"claim_id\":\"r3p00_ct_prep_well_formed\",\"claim_sha256\":\"1414bed2ec0b4b46d728358ef6e0e78ccd98fb64e685cd2936f2426477077369\",\"evidence_id\":\"lean_kernel_r3p00_ct_prep_well_formed_1414bed2\",\"limitations\":[\"kernel support is restricted to claim r3p00_ct_prep_well_formed under semantic profile exact_clifford_t_v2 and does not extend across profile boundaries\",\"qpcert replay, not the theorem name or digest fields alone, binds the normalized IR to this generated Lean term\"],\"outcome\":\"supports\",\"payload\":{\"axiom_ledger\":[],\"axiom_probe_sha256\":\"55565378188c9544067acbd3d4e8037cdf1255ec038bb19a65636dfe4e93cc04\",\"dependency_manifest_sha256\":\"e87a77dcb0890f02235d37157143a36e24e321c5da103886dfa37c0d75359f10\",\"evidence_kind\":\"lean_kernel\",\"module\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372\",\"source_sha256\":\"1f80c9a90c7030f529681137aefb487ec8a9b551d3c4dbcbb9146b5cdda74f48\",\"theorem\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372.claim_r3p00_ct_prep_well_formed\",\"toolchain_sha256\":\"42779d67b81608af8a12aa4328d2ab47ca201925b3b2bd68369587b5340bb434\"},\"tier\":\"kernel_certified\"},{\"artifacts\":[{\"media_type\":\"text/x-lean\",\"path\":\"proof/Generated.lean\",\"role\":\"lean_source\",\"sha256\":\"1f80c9a90c7030f529681137aefb487ec8a9b551d3c4dbcbb9146b5cdda74f48\"},{\"media_type\":\"application/json\",\"path\":\"proof/axiom_probe.json\",\"role\":\"axiom_probe\",\"sha256\":\"55565378188c9544067acbd3d4e8037cdf1255ec038bb19a65636dfe4e93cc04\"},{\"media_type\":\"application/json\",\"path\":\"proof/dependency_manifest.json\",\"role\":\"kernel_dependency_manifest\",\"sha256\":\"e87a77dcb0890f02235d37157143a36e24e321c5da103886dfa37c0d75359f10\"},{\"media_type\":\"text/plain\",\"path\":\"environment/lean-toolchain\",\"role\":\"lean_toolchain\",\"sha256\":\"42779d67b81608af8a12aa4328d2ab47ca201925b3b2bd68369587b5340bb434\"}],\"circuit_subject_sha256\":\"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a\",\"claim_id\":\"r3p00_ct_prep_action\",\"claim_sha256\":\"c5e1bd8e4bdcef6ebc06cdefc53d0dbe5585063272963a608583e2ec1f2f9f6d\",\"evidence_id\":\"lean_kernel_r3p00_ct_prep_action_c5e1bd8e\",\"limitations\":[\"kernel support is restricted to claim r3p00_ct_prep_action under semantic profile exact_clifford_t_v2 and does not extend across profile boundaries\",\"qpcert replay, not the theorem name or digest fields alone, binds the normalized IR to this generated Lean term\"],\"outcome\":\"supports\",\"payload\":{\"axiom_ledger\":[],\"axiom_probe_sha256\":\"55565378188c9544067acbd3d4e8037cdf1255ec038bb19a65636dfe4e93cc04\",\"dependency_manifest_sha256\":\"e87a77dcb0890f02235d37157143a36e24e321c5da103886dfa37c0d75359f10\",\"evidence_kind\":\"lean_kernel\",\"module\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372\",\"source_sha256\":\"1f80c9a90c7030f529681137aefb487ec8a9b551d3c4dbcbb9146b5cdda74f48\",\"theorem\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372.claim_r3p00_ct_prep_action\",\"toolchain_sha256\":\"42779d67b81608af8a12aa4328d2ab47ca201925b3b2bd68369587b5340bb434\"},\"tier\":\"kernel_certified\"}],\"ledger_id\":\"r3p00_ct_prep_claims\",\"metadata\":{\"qpcert_state\":\"per_instance_kernel_evidence_attached\",\"state\":\"obligations_only\"},\"schema\":\"heyting.quantum_claim_evidence.v1\",\"semantic_profile\":\"exact_clifford_t_v2\"}","media_type":"application/json","path":"claims/claims.json","sha256":"4d33406d28afd067c76f309eb38cdc650962da2b23ebd59ae8ee2401a6fdbe21"},{"byte_length":1030,"content":"{\"circuit_subject_sha256\":\"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a\",\"claims\":[{\"accepted_evidence_tiers\":[\"kernel_certified\",\"checker_verified\"],\"claim_id\":\"r3p00_ct_prep_well_formed\",\"description\":\"The LiH 3.0 Angstrom Clifford+T state-preparation circuit is admitted by the exact Clifford+T profile.\",\"statement\":{\"claim_type\":\"well_formed\",\"profile\":\"exact_clifford_t_v2\"}},{\"accepted_evidence_tiers\":[\"kernel_certified\",\"checker_verified\"],\"claim_id\":\"r3p00_ct_prep_action\",\"description\":\"The exact D[omega] matrix of the circuit is recomputed and proven unitary; its quotient forgets only unit global phase.\",\"statement\":{\"claim_type\":\"circuit_property\",\"parameters\":{},\"predicate\":{\"name\":\"exact_unitary_action\",\"namespace\":\"HeytingLean.Quantum.ProofCarrying\",\"version\":\"v1\"},\"relation\":\"same_unitary_up_to_global_phase\"}}],\"evidence\":[],\"ledger_id\":\"r3p00_ct_prep_claims\",\"metadata\":{\"state\":\"obligations_only\"},\"schema\":\"heyting.quantum_claim_evidence.v1\",\"semantic_profile\":\"exact_clifford_t_v2\"}","media_type":"application/json","path":"claims/requested_claims.json","sha256":"e2a1b8a7818e99dfc5b4d90f3261eed8e21e7abeb014148cb05bd3426d9fe4bc"},{"byte_length":3148,"content":"{\"version\": \"1.1.0\",\n \"packagesDir\": \".lake/packages\",\n \"packages\":\n [{\"url\": \"https://github.com/leanprover-community/mathlib4\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"\",\n   \"rev\": \"f897ebcf72cd16f89ab4577d0c826cd14afaafc7\",\n   \"name\": \"mathlib\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"f897ebcf72cd16f89ab4577d0c826cd14afaafc7\",\n   \"inherited\": false,\n   \"configFile\": \"lakefile.lean\"},\n  {\"url\": \"https://github.com/leanprover-community/plausible\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"dfd06ebfe8d0e8fa7faba9cb5e5a2e74e7bd2805\",\n   \"name\": \"plausible\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"main\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.toml\"},\n  {\"url\": \"https://github.com/leanprover-community/LeanSearchClient\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"99657ad92e23804e279f77ea6dbdeebaa1317b98\",\n   \"name\": \"LeanSearchClient\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"main\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.toml\"},\n  {\"url\": \"https://github.com/leanprover-community/import-graph\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"d768126816be17600904726ca7976b185786e6b9\",\n   \"name\": \"importGraph\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"main\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.toml\"},\n  {\"url\": \"https://github.com/leanprover-community/ProofWidgets4\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"556caed0eadb7901e068131d1be208dd907d07a2\",\n   \"name\": \"proofwidgets\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"v0.0.74\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.lean\"},\n  {\"url\": \"https://github.com/leanprover-community/aesop\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"725ac8cd67acd70a7beaf47c3725e23484c1ef50\",\n   \"name\": \"aesop\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"master\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.toml\"},\n  {\"url\": \"https://github.com/leanprover-community/quote4\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"dea6a3361fa36d5a13f87333dc506ada582e025c\",\n   \"name\": \"Qq\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"master\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.toml\"},\n  {\"url\": \"https://github.com/leanprover-community/batteries\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"8da40b72fece29b7d3fe3d768bac4c8910ce9bee\",\n   \"name\": \"batteries\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"main\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.toml\"},\n  {\"url\": \"https://github.com/leanprover/lean4-cli\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover\",\n   \"rev\": \"91c18fa62838ad0ab7384c03c9684d99d306e1da\",\n   \"name\": \"Cli\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"main\",\n   \"inherited\": true,\n   \"configFile\": \"lakefile.toml\"}],\n \"name\": \"proofCarryingQuantumRuntime\",\n \"lakeDir\": \".lake\"}\n","media_type":"application/json","path":"environment/lake-manifest.json","sha256":"e89de7992d512493420ae16c3c309355fab0e12029fbe04a273b44e928cea425"},{"byte_length":485,"content":"import Lake\nopen Lake DSL\n\npackage proofCarryingQuantumRuntime where\n  version := v!\"0.1.0\"\n\nrequire mathlib from git\n  \"https://github.com/leanprover-community/mathlib4\" @\n  \"f897ebcf72cd16f89ab4577d0c826cd14afaafc7\"\n\n@[default_target]\nlean_lib HeytingLean where\n  srcDir := \".\"\n\nlean_exe pcq_export_edifice_manifest where\n  root := `HeytingLean.CLI.ExportPCQEdificeManifestMain\n\nlean_exe pcq_export_t09_walking_circuit where\n  root := `HeytingLean.CLI.ExportPCQT09WalkingCircuitMain\n","media_type":"text/x-lean","path":"environment/lakefile.lean","sha256":"b0d55680dab911c20e4dc7cd013fc2155471a2d6d6bd9afe2c75633d894169e0"},{"byte_length":25,"content":"leanprover/lean4:v4.24.0\n","media_type":"text/plain","path":"environment/lean-toolchain","sha256":"42779d67b81608af8a12aa4328d2ab47ca201925b3b2bd68369587b5340bb434"},{"byte_length":60239,"content":"/-!\n# Exact Clifford+T and measurement substrate for proof-carrying circuits\n\nThis module is deliberately finite and reducible.  It supplies a second,\nkernel-executed semantics for Phase 7 certificates.  The scalar carrier is the\ndyadic cyclotomic ring generated by `ω` with `ω⁴ = -1`; measurement is an\noutcome family of subnormalized density matrices built by `K ρ K†`.\n\nNo declaration in this module uses `native_decide`, an axiom, or a floating\npoint approximation.\n-/\n\nnamespace HeytingLean.Quantum.ProofCarrying\n\n/-- Coefficients of `1, ω, ω², ω³`. -/\nstructure OmegaCoeffs where\n  c0 : Int\n  c1 : Int\n  c2 : Int\n  c3 : Int\nderiving DecidableEq, Repr\n\n/-- A normalized element `(c0+c1ω+c2ω²+c3ω³)/2^k`, where `ω⁴=-1`. -/\nstructure DOmega where\n  coeffs : OmegaCoeffs\n  denominatorExponent : Nat\nderiving DecidableEq, Repr\n\nnamespace DOmega\n\ndef allEven (c : OmegaCoeffs) : Bool :=\n  c.c0 % 2 == 0 && c.c1 % 2 == 0 && c.c2 % 2 == 0 && c.c3 % 2 == 0\n\ndef halve (c : OmegaCoeffs) : OmegaCoeffs :=\n  ⟨c.c0 / 2, c.c1 / 2, c.c2 / 2, c.c3 / 2⟩\n\n/-- Canonical reduction removes every common factor of two. -/\ndef normalize : OmegaCoeffs → Nat → DOmega\n  | c, 0 => ⟨c, 0⟩\n  | c, k + 1 => if allEven c then normalize (halve c) k else ⟨c, k + 1⟩\n\ndef ofInt (z : Int) : DOmega := normalize ⟨z, 0, 0, 0⟩ 0\ndef zero : DOmega := ofInt 0\ndef one : DOmega := ofInt 1\ndef omega : DOmega := normalize ⟨0, 1, 0, 0⟩ 0\ndef I : DOmega := normalize ⟨0, 0, 1, 0⟩ 0\ndef half : DOmega := normalize ⟨1, 0, 0, 0⟩ 1\ndef invSqrtTwo : DOmega := normalize ⟨0, 1, 0, -1⟩ 1\n\ndef scaleCoeffs (c : OmegaCoeffs) (n : Nat) : OmegaCoeffs :=\n  let s : Int := Int.ofNat (2 ^ n)\n  ⟨c.c0 * s, c.c1 * s, c.c2 * s, c.c3 * s⟩\n\ndef addCoeffs (a b : OmegaCoeffs) : OmegaCoeffs :=\n  ⟨a.c0 + b.c0, a.c1 + b.c1, a.c2 + b.c2, a.c3 + b.c3⟩\n\ndef negCoeffs (a : OmegaCoeffs) : OmegaCoeffs :=\n  ⟨-a.c0, -a.c1, -a.c2, -a.c3⟩\n\ndef add (a b : DOmega) : DOmega :=\n  let k := max a.denominatorExponent b.denominatorExponent\n  normalize\n    (addCoeffs\n      (scaleCoeffs a.coeffs (k - a.denominatorExponent))\n      (scaleCoeffs b.coeffs (k - b.denominatorExponent))) k\n\ndef neg (a : DOmega) : DOmega := normalize (negCoeffs a.coeffs) a.denominatorExponent\ndef sub (a b : DOmega) : DOmega := add a (neg b)\n\n/-- Multiplication reduced by `ω⁴=-1`. -/\ndef mul (a b : DOmega) : DOmega :=\n  let x := a.coeffs\n  let y := b.coeffs\n  normalize\n    ⟨x.c0*y.c0 - x.c1*y.c3 - x.c2*y.c2 - x.c3*y.c1,\n     x.c0*y.c1 + x.c1*y.c0 - x.c2*y.c3 - x.c3*y.c2,\n     x.c0*y.c2 + x.c1*y.c1 + x.c2*y.c0 - x.c3*y.c3,\n     x.c0*y.c3 + x.c1*y.c2 + x.c2*y.c1 + x.c3*y.c0⟩\n    (a.denominatorExponent + b.denominatorExponent)\n\n/-- Complex conjugation `ω ↦ ω⁻¹ = -ω³`. -/\ndef conj (a : DOmega) : DOmega :=\n  normalize ⟨a.coeffs.c0, -a.coeffs.c3, -a.coeffs.c2, -a.coeffs.c1⟩\n    a.denominatorExponent\n\ninstance : Zero DOmega := ⟨zero⟩\ninstance : One DOmega := ⟨one⟩\n\ntheorem omega_mul_conj : mul omega (conj omega) = one := by decide\ntheorem invSqrtTwo_sq : mul invSqrtTwo invSqrtTwo = half := by decide\ntheorem I_sq : mul I I = neg one := by decide\ntheorem normalization_nonvacuous : normalize ⟨2, 4, 0, 0⟩ 1 = normalize ⟨1, 2, 0, 0⟩ 0 := by decide\n\nend DOmega\n\nabbrev ExactVector := List DOmega\nabbrev ExactMatrix := List ExactVector\n\ndef vectorGet (v : ExactVector) (i : Nat) : DOmega := (v[i]?).getD DOmega.zero\ndef matrixGet (m : ExactMatrix) (i j : Nat) : DOmega := vectorGet ((m[i]?).getD []) j\ndef makeVector (n : Nat) (f : Nat → DOmega) : ExactVector := (List.range n).map f\ndef makeMatrix (n : Nat) (f : Nat → Nat → DOmega) : ExactMatrix :=\n  (List.range n).map fun i => makeVector n (f i)\n\ndef identityMatrix (n : Nat) : ExactMatrix :=\n  makeMatrix n fun i j => if i = j then DOmega.one else DOmega.zero\n\ndef zeroMatrix (n : Nat) : ExactMatrix := makeMatrix n fun _ _ => DOmega.zero\n\ndef matrixAdd (a b : ExactMatrix) : ExactMatrix :=\n  makeMatrix a.length fun i j => DOmega.add (matrixGet a i j) (matrixGet b i j)\n\ndef matrixMul (a b : ExactMatrix) : ExactMatrix :=\n  makeMatrix a.length fun i j =>\n    (List.range a.length).foldl\n      (fun sum k => DOmega.add sum (DOmega.mul (matrixGet a i k) (matrixGet b k j)))\n      DOmega.zero\n\ndef dagger (a : ExactMatrix) : ExactMatrix :=\n  makeMatrix a.length fun i j => DOmega.conj (matrixGet a j i)\n\ndef matrixTrace (a : ExactMatrix) : DOmega :=\n  (List.range a.length).foldl (fun sum i => DOmega.add sum (matrixGet a i i)) DOmega.zero\n\ndef basisVector (dimension column : Nat) : ExactVector :=\n  makeVector dimension fun row => if row = column then DOmega.one else DOmega.zero\n\ndef qubitBit (basis qubit : Nat) : Nat := basis / (2 ^ qubit) % 2\ndef flipBit (basis qubit : Nat) : Nat :=\n  if qubitBit basis qubit = 0 then basis + 2 ^ qubit else basis - 2 ^ qubit\n\n/-- The axis of a parameterized rotation.  `phase` is `diag(1, z^e)` and `rz` is\n`diag(z^-e, z^e)`: they differ by a global phase, which becomes OBSERVABLE once\ncontrolled, so they are deliberately distinct axes rather than one. -/\ninductive RotAxis where\n  | phase | rz | rx | ry\nderiving DecidableEq, Repr\n\n/-! ## Cyclotomic carrier of order `2^k`\n\n`DOmega` is `Z[1/2, zeta_8]` with `omega^4 = -1`.  That is not a special design:\nit is the `k = 3` member of a tower\n\n  `Z[1/2, zeta_8]  <  Z[1/2, zeta_16]  <  Z[1/2, zeta_32]  <  ...`\n\nwhere `zeta_{2^k} = zeta_{2^(k+1)}^2`.  Each level is the twisted group ring\n`Z[x]/(x^h + 1)` with `h = 2^(k-1)`, because `Phi_{2^k}(x) = x^h + 1`.  So\nmultiplication is NEGACYCLIC convolution: indices wrap around with a SIGN FLIP.\n\n(Structurally this is the same ring as ML-DSA's `(ZMod q)[X]/(X^256 + 1)` — see\n`HeytingLean/Crypto/Lattice/NTTConvolution.lean`.  Same construction, different\ncoefficient ring; the two are related by base change, not by analogy.)\n\nCANONICITY IS LOAD-BEARING.  `decide` compares REPRESENTATIONS, so two spellings\nof one value would make true identities unprovable.  `normalize` therefore fixes\nthe length to exactly `half`, folds every index `>= half` down with a sign flip,\nand strips a common factor of two from the numerator.  Without all three, the\ngate identities below would fail as false negatives. -/\n\n/-- An element of `Z[1/2, zeta_{2^k}]`: coefficients of `1, z, ..., z^(half-1)`\nover `2^denominatorExponent`, where `half = 2^(k-1)` and `z^half = -1`. -/\nstructure Cyc where\n  half : Nat\n  coeffs : List Int\n  denominatorExponent : Nat\nderiving DecidableEq, Repr\n\nnamespace Cyc\n\n/-- Pad or truncate to exactly `h` entries, so length is part of canonical form. -/\ndef fit (h : Nat) (c : List Int) : List Int :=\n  (List.range h).map fun i => (c.get? i).getD 0\n\n/-- Fold indices `>= half` down by one wrap with a sign flip (`z^half = -1`).\nA convolution of two length-`h` vectors has degree `< 2h`, so one pass suffices. -/\ndef reduceNeg (h : Nat) (c : List Int) : List Int :=\n  (List.range h).map fun i =>\n    ((c.get? i).getD 0) - ((c.get? (i + h)).getD 0)\n\ndef allEven (c : List Int) : Bool := c.all (fun x => x % 2 == 0)\n\n/-- Canonical form: exact length, reduced, and numerator stripped of common 2s. -/\ndef normalize (h : Nat) (c : List Int) (k : Nat) : Cyc :=\n  let c := fit h (reduceNeg h (fit (2 * h) c))\n  let rec strip (c : List Int) (k : Nat) (fuel : Nat) : List Int × Nat :=\n    match fuel with\n    | 0 => (c, k)\n    | fuel + 1 =>\n        if k > 0 && allEven c then strip (c.map (· / 2)) (k - 1) fuel else (c, k)\n  let (c, k) := strip c k (k + 1)\n  ⟨h, c, k⟩\n\ndef zero (h : Nat) : Cyc := normalize h (List.replicate h 0) 0\ndef one (h : Nat) : Cyc := normalize h (1 :: List.replicate (h - 1) 0) 0\n\n/-- `z^e`, the `e`-th power of the primitive root, reduced into canonical form. -/\ndef zetaPow (h e : Nat) : Cyc :=\n  normalize h ((List.range (2 * h)).map fun i => if i == e % (2 * h) then 1 else 0) 0\n\ndef add (a b : Cyc) : Cyc :=\n  let k := max a.denominatorExponent b.denominatorExponent\n  let scale (x : Cyc) := x.coeffs.map (· * (2 ^ (k - x.denominatorExponent) : Int))\n  normalize a.half (List.zipWith (· + ·) (fit a.half (scale a)) (fit a.half (scale b))) k\n\ndef neg (a : Cyc) : Cyc := ⟨a.half, a.coeffs.map (- ·), a.denominatorExponent⟩\n\ndef sub (a b : Cyc) : Cyc := add a (neg b)\n\n/-- Negacyclic convolution: the canonical representative of the product in\n`Z[x]/(x^half + 1)`. -/\ndef mul (a b : Cyc) : Cyc :=\n  let h := a.half\n  let raw : List Int :=\n    (List.range (2 * h)).map fun n =>\n      ((List.range (n + 1)).map fun i =>\n        ((a.coeffs.get? i).getD 0) * ((b.coeffs.get? (n - i)).getD 0)).sum\n  normalize h raw (a.denominatorExponent + b.denominatorExponent)\n\n/-- Embed `DOmega` (the `k = 3` level) into the tower. -/\ndef ofDOmega (d : DOmega) : Cyc :=\n  normalize 4 [d.coeffs.c0, d.coeffs.c1, d.coeffs.c2, d.coeffs.c3] d.denominatorExponent\n\n/-- Raise a level-`k` element into level `k+1` by spreading coefficients onto the\neven powers, since `zeta_{2^k} = zeta_{2^(k+1)}^2`.  This is the tower map. -/\ndef lift (a : Cyc) : Cyc :=\n  normalize (2 * a.half)\n    ((List.range (2 * a.half)).map fun i =>\n      if i % 2 == 0 then (a.coeffs.get? (i / 2)).getD 0 else 0)\n    a.denominatorExponent\n\nend Cyc\n\n/-! ### Parameterized rotations over the cyclotomic carrier\n\nThe six gates the vocabulary was missing — `Rzk`, `Crk`, `Rz`, `Rx`, `Ry`,\n`Cry` — are all rotations by a RATIONAL multiple of pi, and every such rotation\nis exact here: `cos(e*pi/h) = (z^e + z^-e)/2` and `sin(e*pi/h) = (z^e - z^-e)/2i`\nwith `z = zeta_{2h}`.  Nothing is approximated and nothing is fenced off.\n\n`z^-e` is written `z^(2h - e)`, using `z^(2h) = 1`.\n\nEach definition is anchored below by a theorem identifying it with a gate that\nalready existed at the parameter where the two must coincide.  A rotation family\nthat did not reproduce `S`, `T` and `Z` at its own fixed points would be a\ndifferent family wearing their name. -/\n\nnamespace Cyc\n\n/-- `z^(-e)` at level `half = h`, i.e. `z^(2h - e)`. -/\ndef zetaPowInv (h e : Nat) : Cyc := zetaPow h ((2 * h) - (e % (2 * h)))\n\n/-- Divide by two: bump the denominator exponent, then re-canonicalise. -/\ndef halveC (a : Cyc) : Cyc := normalize a.half a.coeffs (a.denominatorExponent + 1)\n\n/-- `i` at level `half = h`, namely `z^(h/2)`, since `z^h = -1`. -/\ndef iAt (h : Nat) : Cyc := zetaPow h (h / 2)\n\n/-- `cos(e*pi/h) = (z^e + z^-e)/2`, exactly. -/\ndef cosPi (h e : Nat) : Cyc := halveC (add (zetaPow h e) (zetaPowInv h e))\n\n/-- `sin(e*pi/h) = (z^e - z^-e)/(2i) = -i*(z^e - z^-e)/2`, exactly. -/\ndef sinPi (h e : Nat) : Cyc :=\n  halveC (mul (neg (iAt h)) (sub (zetaPow h e) (zetaPowInv h e)))\n\n/-- `Ry(theta)` with `theta = 2*e*pi/h`: `[[c, -s], [s, c]]`. -/\ndef ryGate (h e : Nat) : Cyc × Cyc × Cyc × Cyc :=\n  (cosPi h e, neg (sinPi h e), sinPi h e, cosPi h e)\n\n/-- `Rx(theta)` with `theta = 2*e*pi/h`: `[[c, -i*s], [-i*s, c]]`. -/\ndef rxGate (h e : Nat) : Cyc × Cyc × Cyc × Cyc :=\n  let ms := mul (neg (iAt h)) (sinPi h e)\n  (cosPi h e, ms, ms, cosPi h e)\n\n/-- `Rz(theta) = diag(z^-e, z^e)` with `theta = 2*e*pi/h`.  Distinct from\n`phaseGate`, which is `diag(1, z^e)`: they differ by the global phase `z^-e`,\nand conflating them is a standard source of sign errors. -/\ndef rzGate (h e : Nat) : Cyc × Cyc × Cyc × Cyc :=\n  (zetaPowInv h e, zero h, zero h, zetaPow h e)\n\n\n/-- The diagonal phase gate `diag(1, z^e)` at level `half = h`. -/\ndef phaseGate (h e : Nat) : Cyc × Cyc × Cyc × Cyc :=\n  (one h, zero h, zero h, zetaPow h e)\n\n/-- `Rzk` at cyclotomic level `k`: `diag(1, zeta_{2^k})`.  Here `h = 2^(k-1)`. -/\ndef rzkGate (h : Nat) (inverse : Bool) : Cyc × Cyc × Cyc × Cyc :=\n  if inverse then phaseGate h ((2 * h) - 1) else phaseGate h 1\n\n\n/-- `Crk`/`Cry` are the CONTROLLED applications of `rzkGate`/`ryGate`.  Their\nbase 2x2 is the same; what differs is that `applyGate` restricts them to the\nsubspace where the control is set.  Naming them separately keeps the vocabulary\nhonest about which operator a certificate refers to. -/\ndef crkBase (h : Nat) (inverse : Bool) : Cyc × Cyc × Cyc × Cyc := rzkGate h inverse\n\ndef cryBase (h e : Nat) : Cyc × Cyc × Cyc × Cyc := ryGate h e\n\n/-- The 2x2 matrix of a parameterized rotation, dispatched on its axis.\n\n`Rzk h inv` is `rot phase h 1 false` / `rot phase h (2h-1) false`, `Crk` is the\nsame with `controlled = true`, and `Cry` is `rot ry h e true`.  All six of the\ngates the vocabulary was missing are instances of this one function. -/\ndef rotGate : RotAxis → Nat → Nat → Cyc × Cyc × Cyc × Cyc\n  | .phase, h, e => phaseGate h e\n  | .rz, h, e => rzGate h e\n  | .rx, h, e => rxGate h e\n  | .ry, h, e => ryGate h e\n\n/-- Read a level-8 element back as a `DOmega`.  `normalize` fixes the coefficient\nlist to exactly `half`, so at `half = 4` this match is total. -/\ndef readAt4 (a : Cyc) : Option DOmega :=\n  match a.coeffs with\n  | [c0, c1, c2, c3] => some (DOmega.normalize ⟨c0, c1, c2, c3⟩ a.denominatorExponent)\n  | _ => none\n\n/-- Partial DOWNCAST `Cyc -> DOmega` — deliberately not a refusal.\n\n`DOmega = Z[1/sqrt 2, i] = Z[1/2, zeta_8]` is exactly the level-8 cyclotomic\nring (Kliuchnikov-Maslov-Mosca), which is `Cyc` at `half = 4`.  The lower levels\n`half = 1` (`zeta_2 = -1`) and `half = 2` (`zeta_4 = i`) sit INSIDE it via the\ntower `zeta_{2^k} = zeta_{2^(k+1)}^2`, i.e. `lift`.\n\nAnswering `none` for every rotation would have been the easy move and a wrong\none: `rot phase 4 1 false` IS the `T` gate, so a blanket `none` would give one\nmathematical gate two spellings with divergent semantics — the same drift seam\nthat put the certified build-target list in three places.  `rot_phase_is_T`\nbelow is the theorem that closes it.\n\n`none` is returned only where it is TRUE: above level 8 the value genuinely\nleaves `DOmega`, and a `half` outside `{1,2,4}` is not a cyclotomic level at all\n(`x^3 + 1` factors, so `Z[x]/(x^3+1)` is not even a domain). -/\ndef toDOmega (a : Cyc) : Option DOmega :=\n  if a.half == 4 then readAt4 a\n  else if a.half == 2 then readAt4 (lift a)\n  else if a.half == 1 then readAt4 (lift (lift a))\n  else none\n\n/-- Downcast a whole 2x2: defined exactly when all four entries are. -/\ndef quadToDOmega (g : Cyc × Cyc × Cyc × Cyc) :\n    Option (DOmega × DOmega × DOmega × DOmega) :=\n  match toDOmega g.1, toDOmega g.2.1, toDOmega g.2.2.1, toDOmega g.2.2.2 with\n  | some a, some b, some c, some d => some (a, b, c, d)\n  | _, _, _, _ => none\nend Cyc\n\n\ninductive ExactGate where\n  | I | H | X | Y | Z | S | Sdg | T | Tdg | CX | CZ | SWAP\n  /-- `sqrt(X)`.  A Clifford gate and an IBM NATIVE basis gate.  Exactly\n  representable here because `i = omega^2` and the denominator is a power of\n  two, so it needs no carrier beyond `DOmega = Z[1/2, zeta_8]`. -/\n  | SX\n  /-- Controlled-`Y`. -/\n  | CY\n  /-- Controlled-`H`.  NOT a Clifford gate: it does not conjugate `I (x) X` to a\n  Pauli, so it is inadmissible in the binary-symplectic profiles and lives only\n  where `T` is primitive. -/\n  | CH\n  /-- Every parameterized rotation, as ONE constructor.\n\n  `Rzk`, `Crk`, `Rz`, `Rx`, `Ry`, `Cry` are not six gates.  They are\n  `axis x angle x controlled`, and `Crk` differs from `Rzk` only in the control\n  flag.  Giving each its own constructor would duplicate the phase semantics\n  across two arms and let them drift — the same failure that put the certified\n  Lean build-target list in three places.  Control is a functor from 1-qubit to\n  2-qubit gates; a `Bool` field is its object-level shadow, written once.\n\n  `half` is `2^(k-1)` for cyclotomic level `k`; the angle is `exponent*pi/half`. -/\n  | rot (axis : RotAxis) (half exponent : Nat) (controlled : Bool)\nderiving DecidableEq, Repr\n\ninductive MeasurementBasis where | X | Y | Z\nderiving DecidableEq, Repr\n\ninductive ExactOp where\n  | gate (gate : ExactGate) (first second : Nat)\n  | measure (basis : MeasurementBasis) (qubit classicalBit : Nat)\n  | reset (qubit : Nat)\n  | barrier\nderiving DecidableEq, Repr\n\n/-! ## Proof-relevant exact-execution frontier\n\n`ExactGate.rot` deliberately accepts a wider rational-pi vocabulary than the\nlegacy `DOmega = Z[1/2, zeta_8]` reference carrier can execute.  Crossing that\nfrontier is not an identity operation.  The checked evaluator below returns a\ntyped continuation request, preserving the exact source rotation so a router\ncan select a wider cyclotomic carrier instead of fabricating a successful\nstate.\n\nThe same boundary rejects measurement and reset in a *unitary* evaluator.  An\ninstrument evaluator may consume those operations, but erasing them to the\nidentity would be the wrong semantic kind.\n-/\n\ninductive ExactExecutionContinuation where\n  | widerCyclotomicCarrier (requestedRootOrder : Nat)\n  | instrumentSemantics\n  | rejectMalformedInput\nderiving DecidableEq, Repr\n\ninductive ExactExecutionFailure where\n  | invalidRotationDenominator\n      (axis : RotAxis) (exponent : Nat) (controlled : Bool)\n  | unsupportedRotationCarrier\n      (axis : RotAxis) (half exponent : Nat) (controlled : Bool)\n  | measurementInUnitaryPath\n      (basis : MeasurementBasis) (qubit classicalBit : Nat)\n  | resetInUnitaryPath (qubit : Nat)\nderiving DecidableEq, Repr\n\n/-- A BHK witness for why exact execution stopped and which semantic fiber can\ncontinue it.  `operationIndex` and `stateDimension` bind the obstruction to an\nactual execution path rather than a gate-name-only capability assertion. -/\nstructure ExactExecutionFailureReceipt where\n  failure : ExactExecutionFailure\n  continuation : ExactExecutionContinuation\n  operationIndex : Nat\n  stateDimension : Nat\nderiving DecidableEq, Repr\n\n/-- Minimal root-of-unity order for `exp(i * exponent * pi / half)`.  This is\nthe same gcd reduction used by T10's arbitrary rational-pi specialization; the\nreceipt therefore requests the smallest cyclotomic fiber that can represent\nthe phase instead of mechanically overprovisioning order `2 * half`. -/\ndef rotationRootOrder (half exponent : Nat) : Nat :=\n  let twiceHalf := 2 * half\n  twiceHalf / Nat.gcd exponent twiceHalf\n\n/-- Smallest root-of-unity order requested by the matrix entries.  `Ry` needs\nthe quadrature root `i` to recover a nonzero real sine when the reduced phase\nfield does not already contain it; the trivial/sign cases have zero sine and\nneed no enlargement.  The other axes are expressible in the reduced phase\nfield itself (`Rx` absorbs the extra `-i` into its off-diagonal entries). -/\ndef rotationCarrierRootOrder (axis : RotAxis) (half exponent : Nat) : Nat :=\n  let phaseOrder := rotationRootOrder half exponent\n  match axis with\n  | .ry => if phaseOrder ≤ 2 then phaseOrder else Nat.lcm phaseOrder 4\n  | .phase | .rz | .rx => phaseOrder\n\n/-- Canonical parameters for the part of a rational-pi rotation that already\nlives in `DOmega`.  Source spellings are not required to be reduced: for\nexample, `half = 8, exponent = 2` has order eight and is the ordinary `T`\nphase.  Orders one, two, four, and eight are exactly the root-of-unity orders\navailable in `Z[1/2, zeta_8]`; every other order is routed outward. -/\ndef rotationDOmegaParameters? (half exponent : Nat) : Option (Nat × Nat) :=\n  if half == 0 then none\n  else\n    let twiceHalf := 2 * half\n    let common := Nat.gcd exponent twiceHalf\n    let order := twiceHalf / common\n    let reducedExponent := (exponent / common) % order\n    match order with\n    | 1 => some (1, 0)\n    | 2 => some (1, reducedExponent)\n    | 4 => some (2, reducedExponent)\n    | 8 => some (4, reducedExponent)\n    | _ => none\n\n/-- Gcd-normalize a source rotation before attempting the `DOmega` downcast.\nThis accepts every source spelling whose actual root order divides eight while\npreserving a fail-closed `none` for a genuinely wider cyclotomic carrier. -/\ndef rotationDOmegaBlock? (axis : RotAxis) (half exponent : Nat) :\n    Option (DOmega × DOmega × DOmega × DOmega) :=\n  match rotationDOmegaParameters? half exponent with\n  | some (reducedHalf, reducedExponent) =>\n      Cyc.quadToDOmega (Cyc.rotGate axis reducedHalf reducedExponent)\n  | none => none\n\ndef rotationExecutionFailureReceipt (operationIndex stateDimension : Nat)\n    (axis : RotAxis) (half exponent : Nat) (controlled : Bool) :\n    ExactExecutionFailureReceipt :=\n  if half = 0 then\n    { failure := .invalidRotationDenominator axis exponent controlled\n      continuation := .rejectMalformedInput\n      operationIndex\n      stateDimension }\n  else\n    { failure := .unsupportedRotationCarrier axis half exponent controlled\n      continuation := .widerCyclotomicCarrier\n        (rotationCarrierRootOrder axis half exponent)\n      operationIndex\n      stateDimension }\n\n/-- Carrier admission shared by unitary and instrument claim boundaries.  It is\nstrictly about exact representability, not backend availability: a wider\nbackend may still accept the source operation after typed routing. -/\ndef exactGateCarrierAdmissible : ExactGate → Bool\n  | .rot axis half exponent _ =>\n      half != 0 && (rotationDOmegaBlock? axis half exponent).isSome\n  | _ => true\n\ndef exactOperationCarrierAdmissible : ExactOp → Bool\n  | .gate gate _ _ => exactGateCarrierAdmissible gate\n  | .measure .. | .reset .. | .barrier => true\n\n/-- `(1 + i)/2`, an entry of `sqrt(X)`. -/\ndef onePlusIHalf : DOmega := DOmega.normalize ⟨1, 0, 1, 0⟩ 1\n\n/-- `(1 - i)/2`, an entry of `sqrt(X)`. -/\ndef oneMinusIHalf : DOmega := DOmega.normalize ⟨1, 0, -1, 0⟩ 1\n\ndef localGate : ExactGate → Option (DOmega × DOmega × DOmega × DOmega)\n  | .I => some (DOmega.one, DOmega.zero, DOmega.zero, DOmega.one)\n  | .H => some (DOmega.invSqrtTwo, DOmega.invSqrtTwo,\n      DOmega.invSqrtTwo, DOmega.neg DOmega.invSqrtTwo)\n  | .X => some (DOmega.zero, DOmega.one, DOmega.one, DOmega.zero)\n  | .Y => some (DOmega.zero, DOmega.neg DOmega.I, DOmega.I, DOmega.zero)\n  | .Z => some (DOmega.one, DOmega.zero, DOmega.zero, DOmega.neg DOmega.one)\n  | .S => some (DOmega.one, DOmega.zero, DOmega.zero, DOmega.I)\n  | .Sdg => some (DOmega.one, DOmega.zero, DOmega.zero, DOmega.neg DOmega.I)\n  | .SX => some (onePlusIHalf, oneMinusIHalf, oneMinusIHalf, onePlusIHalf)\n  -- Two-qubit gates have no single-qubit local matrix; `applyGate` handles them.\n  | .CY => none\n  | .CH => none\n  -- Parameterized rotations are Cyc-valued.  They DOWNCAST into `DOmega`\n  -- wherever they genuinely live there (`half` in `{1,2,4}`, i.e. inside\n  -- `Z[1/2, zeta_8]`), so `rot phase 4 1 false` and `T` are the same gate with\n  -- the same semantics rather than one defined and one not.  Controlled\n  -- rotations, like `CY`/`CH`, have no single-qubit local matrix.\n  | .rot axis h e ctl =>\n      if ctl then none else Cyc.quadToDOmega (Cyc.rotGate axis h e)\n  | .T => some (DOmega.one, DOmega.zero, DOmega.zero, DOmega.omega)\n  | .Tdg => some (DOmega.one, DOmega.zero, DOmega.zero,\n      DOmega.normalize ⟨0, 0, 0, -1⟩ 0)\n  | .CX | .CZ | .SWAP => none\n\ndef applyOne (qubit : Nat) (g : DOmega × DOmega × DOmega × DOmega)\n    (v : ExactVector) : ExactVector :=\n  makeVector v.length fun row =>\n    let partner := flipBit row qubit\n    if qubitBit row qubit = 0 then\n      DOmega.add (DOmega.mul g.1 (vectorGet v row))\n        (DOmega.mul g.2.1 (vectorGet v partner))\n    else\n      DOmega.add (DOmega.mul g.2.2.1 (vectorGet v partner))\n        (DOmega.mul g.2.2.2 (vectorGet v row))\n\n/-- Apply a one-qubit block to `target` exactly on the subspace where `control`\nis set.  This is the single semantic constructor shared by named controlled\ngates and controlled cyclotomic rotations. -/\ndef applyControlledOne (control target : Nat)\n    (g : DOmega × DOmega × DOmega × DOmega) (v : ExactVector) : ExactVector :=\n  makeVector v.length fun row =>\n    if qubitBit row control = 1 then\n      if qubitBit row target = 0 then\n        DOmega.add (DOmega.mul g.1 (vectorGet v row))\n          (DOmega.mul g.2.1 (vectorGet v (flipBit row target)))\n      else\n        DOmega.add (DOmega.mul g.2.2.1 (vectorGet v (flipBit row target)))\n          (DOmega.mul g.2.2.2 (vectorGet v row))\n    else vectorGet v row\n\ndef yBlock : DOmega × DOmega × DOmega × DOmega :=\n  (DOmega.zero, DOmega.neg DOmega.I, DOmega.I, DOmega.zero)\n\ndef hBlock : DOmega × DOmega × DOmega × DOmega :=\n  (DOmega.invSqrtTwo, DOmega.invSqrtTwo,\n    DOmega.invSqrtTwo, DOmega.neg DOmega.invSqrtTwo)\n\ndef applyGate (gate : ExactGate) (first second : Nat) (v : ExactVector) : ExactVector :=\n  match localGate gate with\n  | some g2 => applyOne first g2 v\n  | none =>\n    match gate with\n    | .CX => makeVector v.length fun row =>\n        vectorGet v (if qubitBit row first = 1 then flipBit row second else row)\n    | .CZ => makeVector v.length fun row =>\n        if qubitBit row first = 1 && qubitBit row second = 1\n        then DOmega.neg (vectorGet v row) else vectorGet v row\n    | .SWAP => makeVector v.length fun row =>\n        if qubitBit row first = qubitBit row second then vectorGet v row\n        else vectorGet v (flipBit (flipBit row first) second)\n    | .CY => applyControlledOne first second yBlock v\n    | .CH => applyControlledOne first second hBlock v\n    -- A CONTROLLED rotation applies its 2x2 to the target exactly where the\n    -- control is set.  Without this case it would fall to the catch-all and\n    -- act as the IDENTITY: nameable, type-correct, downcast-clean, and\n    -- silently doing nothing.  `crk_is_not_the_identity` forbids that.\n    | .rot axis h e true =>\n        match Cyc.quadToDOmega (Cyc.rotGate axis h e) with\n        | some g => applyControlledOne first second g v\n        | none => makeVector v.length (vectorGet v)\n    | _ => makeVector v.length (vectorGet v)\n\n/-- Exact action after reducing a source rotation to its actual root order.\nThis is the semantic success target of the checked boundary.  The historical\n`applyGate` remains available for compatibility with proofs over canonical\nsource spellings; this function additionally accepts equivalent non-reduced\nspellings without contaminating those established proofs. -/\ndef applyGateCarrierNormalized (gate : ExactGate) (first second : Nat)\n    (v : ExactVector) : ExactVector :=\n  match gate with\n  | .rot axis half exponent controlled =>\n      match rotationDOmegaBlock? axis half exponent with\n      | some block =>\n          if controlled then applyControlledOne first second block v\n          else applyOne first block v\n      | none => applyGate gate first second v\n  | other => applyGate other first second v\n\n/-- Authoritative `DOmega` execution boundary.  Unlike the historical total\n`applyGate`, this function cannot turn a rotation outside the carrier into an\nidentity.  The successful branch consumes the actual downcast block; the\nfailure branch retains every rotation parameter and requests the wider\ncyclotomic fiber. -/\ndef applyGateChecked (operationIndex : Nat) (gate : ExactGate)\n    (first second : Nat) (v : ExactVector) :\n    Except ExactExecutionFailureReceipt ExactVector :=\n  match gate with\n  | .rot axis half exponent controlled =>\n      if half = 0 then\n        .error (rotationExecutionFailureReceipt operationIndex v.length\n          axis half exponent controlled)\n      else\n        match rotationDOmegaBlock? axis half exponent with\n        | some block =>\n            .ok (if controlled then applyControlledOne first second block v\n              else applyOne first block v)\n        | none => .error (rotationExecutionFailureReceipt operationIndex v.length\n            axis half exponent controlled)\n  | other => .ok (applyGate other first second v)\n\ndef applyUnitaryOp (op : ExactOp) (v : ExactVector) : ExactVector :=\n  match op with\n  | .gate gate first second => applyGate gate first second v\n  | .barrier => v\n  | .measure .. | .reset .. => v\n\ndef applyUnitaryOpCarrierNormalized (op : ExactOp) (v : ExactVector) : ExactVector :=\n  match op with\n  | .gate gate first second => applyGateCarrierNormalized gate first second v\n  | .barrier => v\n  | .measure .. | .reset .. => v\n\n/-- Checked unitary dispatch. Measurement and reset are routed to instrument\nsemantics rather than silently erased. -/\ndef applyUnitaryOpChecked (operationIndex : Nat) (op : ExactOp)\n    (v : ExactVector) : Except ExactExecutionFailureReceipt ExactVector :=\n  match op with\n  | .gate gate first second => applyGateChecked operationIndex gate first second v\n  | .barrier => .ok v\n  | .measure basis qubit classicalBit => .error\n      { failure := .measurementInUnitaryPath basis qubit classicalBit\n        continuation := .instrumentSemantics\n        operationIndex\n        stateDimension := v.length }\n  | .reset qubit => .error\n      { failure := .resetInUnitaryPath qubit\n        continuation := .instrumentSemantics\n        operationIndex\n        stateDimension := v.length }\n\ndef runUnitaryState (ops : List ExactOp) (v : ExactVector) : ExactVector :=\n  ops.foldl (fun state op => applyUnitaryOp op state) v\n\ndef runUnitaryStateCarrierNormalized (ops : List ExactOp) (v : ExactVector) : ExactVector :=\n  ops.foldl (fun state op => applyUnitaryOpCarrierNormalized op state) v\n\nprivate def runUnitaryStateCheckedFrom : Nat → List ExactOp → ExactVector →\n    Except ExactExecutionFailureReceipt ExactVector\n  | _, [], state => .ok state\n  | operationIndex, op :: rest, state =>\n      match applyUnitaryOpChecked operationIndex op state with\n      | .error receipt => .error receipt\n      | .ok next => runUnitaryStateCheckedFrom (operationIndex + 1) rest next\n\n/-- Execute a unitary word or return the first proof-relevant obstruction. -/\ndef runUnitaryStateChecked (ops : List ExactOp) (v : ExactVector) :\n    Except ExactExecutionFailureReceipt ExactVector :=\n  runUnitaryStateCheckedFrom 0 ops v\n\n/-- Matrix columns of the exact action. -/\ndef unitaryColumns (qubits : Nat) (ops : List ExactOp) : ExactMatrix :=\n  let dimension := 2 ^ qubits\n  (List.range dimension).map fun column =>\n    runUnitaryState ops (basisVector dimension column)\n\ndef columnsToRows (columns : ExactMatrix) : ExactMatrix :=\n  makeMatrix columns.length fun row column => matrixGet columns column row\n\ndef unitaryMatrix (qubits : Nat) (ops : List ExactOp) : ExactMatrix :=\n  columnsToRows (unitaryColumns qubits ops)\n\nprivate def unitaryColumnsCheckedFrom (ops : List ExactOp) (dimension : Nat) :\n    List Nat → Except ExactExecutionFailureReceipt ExactMatrix\n  | [] => .ok []\n  | column :: rest =>\n      match runUnitaryStateChecked ops (basisVector dimension column) with\n      | .error receipt => .error receipt\n      | .ok value =>\n          match unitaryColumnsCheckedFrom ops dimension rest with\n          | .error receipt => .error receipt\n          | .ok tail => .ok (value :: tail)\n\n/-- Checked matrix construction.  This is the exact-reference authority for\nnew claims; `unitaryMatrix` remains only as a compatibility evaluator for the\nalready-proved representable fragment. -/\ndef unitaryMatrixChecked (qubits : Nat) (ops : List ExactOp) :\n    Except ExactExecutionFailureReceipt ExactMatrix :=\n  match unitaryColumnsCheckedFrom ops (2 ^ qubits) (List.range (2 ^ qubits)) with\n  | .error receipt => .error receipt\n  | .ok columns => .ok (columnsToRows columns)\n\ndef unitaryInvariant (qubits : Nat) (ops : List ExactOp) : Bool :=\n  let U := unitaryMatrix qubits ops\n  decide (matrixMul (dagger U) U = identityMatrix (2 ^ qubits))\n\n/-- Fail-closed exact-unitary decision.  A Boolean is produced only after the\nentire word has executed in the declared carrier. -/\ndef unitaryInvariantChecked (qubits : Nat) (ops : List ExactOp) :\n    Except ExactExecutionFailureReceipt Bool :=\n  match unitaryMatrixChecked qubits ops with\n  | .error receipt => .error receipt\n  | .ok U => .ok (decide (matrixMul (dagger U) U = identityMatrix (2 ^ qubits)))\n\n/-! A successful checked run is not an unrelated second semantics: it is a\nproof-relevant restriction of the carrier-normalized exact action, which agrees\nwith the established evaluator on canonical representable spellings and also\naccepts their gcd-equivalent source forms. -/\n\ntheorem applyGateChecked_success {operationIndex : Nat} {gate : ExactGate}\n    {first second : Nat} {input output : ExactVector}\n    (success : applyGateChecked operationIndex gate first second input = .ok output) :\n    output = applyGateCarrierNormalized gate first second input := by\n  cases gate with\n  | rot axis half exponent controlled =>\n      by_cases nonzero : half = 0\n      · simp [applyGateChecked, nonzero] at success\n      · cases downcast : rotationDOmegaBlock? axis half exponent with\n        | none => simp [applyGateChecked, nonzero, downcast] at success\n        | some block =>\n            cases controlled <;>\n              simpa [applyGateChecked, applyGateCarrierNormalized, nonzero, downcast]\n                using success.symm\n  | _ => simpa [applyGateChecked, applyGateCarrierNormalized] using success.symm\n\ntheorem applyUnitaryOpChecked_success {operationIndex : Nat} {op : ExactOp}\n    {input output : ExactVector}\n    (success : applyUnitaryOpChecked operationIndex op input = .ok output) :\n    output = applyUnitaryOpCarrierNormalized op input := by\n  cases op with\n  | gate gate first second =>\n      simpa [applyUnitaryOpCarrierNormalized] using applyGateChecked_success success\n  | measure basis qubit classicalBit =>\n      simp [applyUnitaryOpChecked] at success\n  | reset qubit =>\n      simp [applyUnitaryOpChecked] at success\n  | barrier =>\n      simpa [applyUnitaryOpChecked, applyUnitaryOpCarrierNormalized] using success.symm\n\nprivate theorem runUnitaryStateCheckedFrom_success (operationIndex : Nat)\n    (ops : List ExactOp) (input output : ExactVector)\n    (success : runUnitaryStateCheckedFrom operationIndex ops input = .ok output) :\n    output = runUnitaryStateCarrierNormalized ops input := by\n  induction ops generalizing operationIndex input output with\n  | nil => simpa [runUnitaryStateCheckedFrom, runUnitaryStateCarrierNormalized] using success.symm\n  | cons op rest induction =>\n      cases step : applyUnitaryOpChecked operationIndex op input with\n      | error receipt =>\n          simp [runUnitaryStateCheckedFrom, step] at success\n      | ok next =>\n          have tail : output = runUnitaryStateCarrierNormalized rest next :=\n            induction (operationIndex + 1) next output (by\n              simpa [runUnitaryStateCheckedFrom, step] using success)\n          have stepExact : next = applyUnitaryOpCarrierNormalized op input :=\n            applyUnitaryOpChecked_success step\n          simpa [runUnitaryStateCarrierNormalized, stepExact] using tail\n\ntheorem runUnitaryStateChecked_success {ops : List ExactOp} {input output : ExactVector}\n    (success : runUnitaryStateChecked ops input = .ok output) :\n    output = runUnitaryStateCarrierNormalized ops input :=\n  runUnitaryStateCheckedFrom_success 0 ops input output success\n\ndef outerDensity (v : ExactVector) : ExactMatrix :=\n  makeMatrix v.length fun i j => DOmega.mul (vectorGet v i) (DOmega.conj (vectorGet v j))\n\ndef conjugateAction (K rho : ExactMatrix) : ExactMatrix := matrixMul (matrixMul K rho) (dagger K)\n\ndef embeddedSingle (dimension qubit : Nat)\n    (g : DOmega × DOmega × DOmega × DOmega) : ExactMatrix :=\n  makeMatrix dimension fun row column =>\n    if row / (2 ^ (qubit + 1)) = column / (2 ^ (qubit + 1)) &&\n       row % (2 ^ qubit) = column % (2 ^ qubit) then\n      match qubitBit row qubit, qubitBit column qubit with\n      | 0, 0 => g.1\n      | 0, 1 => g.2.1\n      | 1, 0 => g.2.2.1\n      | _, _ => g.2.2.2\n    else DOmega.zero\n\ndef projector (basis : MeasurementBasis) (outcome : Bool) :\n    DOmega × DOmega × DOmega × DOmega :=\n  let s := if outcome then DOmega.neg DOmega.one else DOmega.one\n  match basis with\n  | .Z => if outcome then (DOmega.zero, DOmega.zero, DOmega.zero, DOmega.one)\n      else (DOmega.one, DOmega.zero, DOmega.zero, DOmega.zero)\n  | .X => (DOmega.half, DOmega.mul DOmega.half s,\n      DOmega.mul DOmega.half s, DOmega.half)\n  | .Y =>\n      let upper := DOmega.neg (DOmega.mul (DOmega.mul DOmega.half DOmega.I) s)\n      (DOmega.half, upper, DOmega.conj upper, DOmega.half)\n\ndef resetKraus (dimension qubit : Nat) (outcome : Bool) : ExactMatrix :=\n  makeMatrix dimension fun row column =>\n    if qubitBit row qubit = 0 && qubitBit column qubit = (if outcome then 1 else 0) &&\n       row / (2 ^ (qubit + 1)) = column / (2 ^ (qubit + 1)) &&\n       row % (2 ^ qubit) = column % (2 ^ qubit)\n    then DOmega.one else DOmega.zero\n\n/-- Fixed-size classical store: `none` means not yet assigned. -/\nstructure ExactBranch where\n  classicalState : List (Option Bool)\n  density : ExactMatrix\nderiving DecidableEq, Repr\n\ndef replaceAt {α : Type} : List α → Nat → α → List α\n  | [], _, _ => []\n  | _ :: rest, 0, value => value :: rest\n  | head :: rest, index + 1, value => head :: replaceAt rest index value\n\ndef matrixIsZero (m : ExactMatrix) : Bool :=\n  m.all fun row => row.all fun value => decide (value = DOmega.zero)\n\ndef mergeBranch (branch : ExactBranch) : List ExactBranch → List ExactBranch\n  | [] => [branch]\n  | candidate :: rest =>\n      if branch.classicalState = candidate.classicalState then\n        { candidate with density := matrixAdd candidate.density branch.density } :: rest\n      else candidate :: mergeBranch branch rest\n\ndef mergeBranches (branches : List ExactBranch) : List ExactBranch :=\n  branches.foldl (fun merged branch => mergeBranch branch merged) []\n\ndef unitaryOperator (qubits : Nat) (gate : ExactGate) (first second : Nat) : ExactMatrix :=\n  unitaryMatrix qubits [ExactOp.gate gate first second]\n\ndef stepInstrument (qubits : Nat) (op : ExactOp) (branches : List ExactBranch) :\n    List ExactBranch :=\n  let dimension := 2 ^ qubits\n  match op with\n  | .barrier => branches\n  | .gate gate first second =>\n      let U := unitaryOperator qubits gate first second\n      branches.map fun branch => { branch with density := conjugateAction U branch.density }\n  | .measure basis qubit classicalBit =>\n      mergeBranches <| branches.flatMap fun branch =>\n        [false, true].filterMap fun outcome =>\n          let K := embeddedSingle dimension qubit (projector basis outcome)\n          let rho := conjugateAction K branch.density\n          if matrixIsZero rho then none else some {\n            classicalState := replaceAt branch.classicalState classicalBit (some outcome)\n            density := rho }\n  | .reset qubit =>\n      let K0 := resetKraus dimension qubit false\n      let K1 := resetKraus dimension qubit true\n      branches.map fun branch =>\n        let rho := matrixAdd (conjugateAction K0 branch.density)\n          (conjugateAction K1 branch.density)\n        { branch with density := rho }\n\ndef runInstrument (qubits classicalBits : Nat) (ops : List ExactOp) : List ExactBranch :=\n  let dimension := 2 ^ qubits\n  let initial := { classicalState := List.replicate classicalBits none\n                   density := outerDensity (basisVector dimension 0) : ExactBranch }\n  ops.foldl (fun branches op => stepInstrument qubits op branches) [initial]\n\ndef totalOutcomeTrace (branches : List ExactBranch) : DOmega :=\n  branches.foldl (fun sum branch => DOmega.add sum (matrixTrace branch.density)) DOmega.zero\n\ndef allHermitian (branches : List ExactBranch) : Bool :=\n  branches.all fun branch => decide (dagger branch.density = branch.density)\n\n/-! Concrete gate and instrument checks anchor the generic evaluator. -/\n\ntheorem h_unitary : unitaryInvariant 1 [ExactOp.gate .H 0 0] = true := by decide\ntheorem t_unitary : unitaryInvariant 1 [ExactOp.gate .T 0 0] = true := by decide\ntheorem cx_unitary : unitaryInvariant 2 [ExactOp.gate .CX 0 1] = true := by decide\ntheorem y_projectors_complete :\n    let p0 := embeddedSingle 2 0 (projector .Y false)\n    let p1 := embeddedSingle 2 0 (projector .Y true)\n    matrixAdd p0 p1 = identityMatrix 2 := by decide\n\ndef phaseScale (phase : DOmega) (m : ExactMatrix) : ExactMatrix :=\n  m.map fun row => row.map fun entry => DOmega.mul phase entry\n\n/-- Division-free projective coordinates. -/\ndef projectByPivot (pivot : DOmega) (m : ExactMatrix) : ExactMatrix :=\n  m.map fun row => row.map fun entry => DOmega.mul entry (DOmega.conj pivot)\n\n/-- The least equivalence relation generated by multiplication by a\nconstructively exhibited exact unit phase.  A proof is a finite BHK path:\neither reflexivity, a unit-phase witness, reversal, or concatenation.  This\navoids assuming unproved ring laws for arbitrary non-normalized raw tuples. -/\ninductive GlobalPhaseEquivalent : ExactMatrix → ExactMatrix → Prop where\n  | refl (a : ExactMatrix) : GlobalPhaseEquivalent a a\n  | unitPhase (phase : DOmega) (matrix : ExactMatrix)\n      (unitWitness : DOmega.mul phase (DOmega.conj phase) = DOmega.one) :\n      GlobalPhaseEquivalent (phaseScale phase matrix) matrix\n  | symm {a b : ExactMatrix} : GlobalPhaseEquivalent a b → GlobalPhaseEquivalent b a\n  | trans {a b c : ExactMatrix} :\n      GlobalPhaseEquivalent a b → GlobalPhaseEquivalent b c → GlobalPhaseEquivalent a c\n\ndef hMatrix : ExactMatrix := unitaryMatrix 1 [ExactOp.gate .H 0 0]\n\ntheorem omega_phase_changes_h : phaseScale DOmega.omega hMatrix ≠ hMatrix := by decide\n\ntheorem omega_projective_coordinates_h :\n    projectByPivot DOmega.omega (phaseScale DOmega.omega hMatrix) =\n      projectByPivot DOmega.one hMatrix := by decide\n\n/-- A concrete non-reflexive inhabitant of the global-phase quotient.  Its\nphase and unit proof are data; replacing the body by reflexivity cannot type. -/\ntheorem omega_global_phase_h :\n    GlobalPhaseEquivalent (phaseScale DOmega.omega hMatrix) hMatrix :=\n  GlobalPhaseEquivalent.unitPhase DOmega.omega hMatrix DOmega.omega_mul_conj\n\ntheorem h_measure_z_normalized :\n    totalOutcomeTrace (runInstrument 1 1 [ExactOp.gate .H 0 0, .measure .Z 0 0]) = DOmega.one := by decide\n\ntheorem h_measure_z_hermitian :\n    allHermitian (runInstrument 1 1 [ExactOp.gate .H 0 0, .measure .Z 0 0]) = true := by decide\n\n#print axioms DOmega.omega_mul_conj\n#print axioms h_unitary\n#print axioms t_unitary\n#print axioms cx_unitary\n#print axioms y_projectors_complete\n#print axioms omega_phase_changes_h\n#print axioms omega_projective_coordinates_h\n#print axioms omega_global_phase_h\n#print axioms h_measure_z_normalized\n#print axioms h_measure_z_hermitian\n\n/-! ## New-gate identities, proved in the kernel\n\nThese are the Lean-side authority for `SX`, `CY` and `CH`.  Each states that the\ngate's exact semantics equals a word over gates that were already present, so\nthe new vocabulary adds no new trust: the kernel checks the identity by `decide`\nover the exact `DOmega` carrier, with no `native_decide` and no axioms.\n\nEach identity ships with a refutation so the equalities cannot be vacuous: a\nnear-miss word must be PROVABLY different, or `decide` on the positive direction\nwould be consistent with a collapsed semantics. -/\n\n/-- `sqrt(X) = H S H`, exactly. -/\ntheorem sx_eq_h_s_h :\n    unitaryColumns 1 [ExactOp.gate .SX 0 0]\n      = unitaryColumns 1 [ExactOp.gate .H 0 0, ExactOp.gate .S 0 0, ExactOp.gate .H 0 0] := by decide\n\n/-- Antibody: the opposite handedness is a DIFFERENT operator, so `sx_eq_h_s_h`\nis not an artefact of a degenerate `unitaryColumns`. -/\ntheorem sx_ne_h_sdg_h :\n    unitaryColumns 1 [ExactOp.gate .SX 0 0]\n      ≠ unitaryColumns 1 [ExactOp.gate .H 0 0, ExactOp.gate .Sdg 0 0, ExactOp.gate .H 0 0] := by decide\n\n/-- `sqrt(X)` squares to `X`: the gate is what its name says. -/\ntheorem sx_sq_eq_x :\n    unitaryColumns 1 [ExactOp.gate .SX 0 0, ExactOp.gate .SX 0 0]\n      = unitaryColumns 1 [ExactOp.gate .X 0 0] := by decide\n\n/-- `CY = Sdg(t) . CX(c,t) . S(t)`, exactly. -/\ntheorem cy_eq_sdg_cx_s :\n    unitaryColumns 2 [ExactOp.gate .CY 0 1]\n      = unitaryColumns 2 [ExactOp.gate .Sdg 1 1, ExactOp.gate .CX 0 1, ExactOp.gate .S 1 1] := by decide\n\n/-- Antibody: `CY` is not `CX`. -/\ntheorem cy_ne_cx :\n    unitaryColumns 2 [ExactOp.gate .CY 0 1] ≠ unitaryColumns 2 [ExactOp.gate .CX 0 1] := by decide\n\n/-- `CH = Sdg(t) H(t) Tdg(t) . CX(c,t) . T(t) H(t) S(t)`, exactly. -/\ntheorem ch_eq_clifford_t_word :\n    unitaryColumns 2 [ExactOp.gate .CH 0 1]\n      = unitaryColumns 2 [ExactOp.gate .Sdg 1 1, ExactOp.gate .H 1 1, ExactOp.gate .Tdg 1 1,\n          .gate .CX 0 1, ExactOp.gate .T 1 1, ExactOp.gate .H 1 1, ExactOp.gate .S 1 1] := by decide\n\n/-- Antibody: `CH` is not an uncontrolled `H` on the target. -/\ntheorem ch_ne_h :\n    unitaryColumns 2 [ExactOp.gate .CH 0 1] ≠ unitaryColumns 2 [ExactOp.gate .H 1 1] := by decide\n\n#print axioms sx_eq_h_s_h\n#print axioms sx_sq_eq_x\n#print axioms cy_eq_sdg_cx_s\n#print axioms ch_eq_clifford_t_word\n#print axioms sx_ne_h_sdg_h\n#print axioms cy_ne_cx\n#print axioms ch_ne_h\n\n\n\n\n/-! ### The carrier is anchored to `DOmega`, not merely consistent\n\nA new ring that is internally coherent but unrelated to the one the gates\nactually live in would prove nothing.  These theorems pin `Cyc` at `half = 4` to\n`DOmega`: the defining relation, the generator, and `ofDOmega` commuting with\nboth ring operations on concrete witnesses.  The final theorem is a refutation,\nso the agreement cannot be an artefact of a collapsed equality. -/\n\n/-- The defining relation of the level: `z^4 = -1` when `half = 4`. -/\ntheorem cyc_zeta_pow_half : Cyc.zetaPow 4 4 = Cyc.neg (Cyc.one 4) := by rfl\n\n/-- `omega` in `DOmega` is the generator `z` of the `half = 4` level. -/\ntheorem cyc_omega_is_generator : Cyc.ofDOmega DOmega.omega = Cyc.zetaPow 4 1 := by rfl\n\n/-- `i = omega^2`, in the carrier. -/\ntheorem cyc_I_is_zeta_sq : Cyc.ofDOmega DOmega.I = Cyc.zetaPow 4 2 := by rfl\n\n/-- `ofDOmega` commutes with multiplication on the `T`-gate phase. -/\ntheorem cyc_mul_agrees_omega :\n    Cyc.ofDOmega (DOmega.mul DOmega.omega DOmega.omega)\n      = Cyc.mul (Cyc.ofDOmega DOmega.omega) (Cyc.ofDOmega DOmega.omega) := by rfl\n\n/-- `ofDOmega` commutes with multiplication where the NEGACYCLIC wrap actually\nfires: `omega^3 * omega^3 = omega^6 = -omega^2`. -/\ntheorem cyc_mul_agrees_wraparound :\n    Cyc.ofDOmega (DOmega.mul (DOmega.mul DOmega.omega (DOmega.mul DOmega.omega DOmega.omega))\n        (DOmega.mul DOmega.omega (DOmega.mul DOmega.omega DOmega.omega)))\n      = Cyc.mul\n          (Cyc.ofDOmega (DOmega.mul DOmega.omega (DOmega.mul DOmega.omega DOmega.omega)))\n          (Cyc.ofDOmega (DOmega.mul DOmega.omega (DOmega.mul DOmega.omega DOmega.omega))) := by\n  rfl\n\n/-- `ofDOmega` commutes with addition, including denominator alignment\n(`invSqrtTwo` carries a denominator, `one` does not). -/\ntheorem cyc_add_agrees :\n    Cyc.ofDOmega (DOmega.add DOmega.one DOmega.invSqrtTwo)\n      = Cyc.add (Cyc.ofDOmega DOmega.one) (Cyc.ofDOmega DOmega.invSqrtTwo) := by rfl\n\n/-- `1/sqrt2` squares to `1/2` in the carrier, matching `DOmega.invSqrtTwo_sq`. -/\ntheorem cyc_invSqrtTwo_sq :\n    Cyc.mul (Cyc.ofDOmega DOmega.invSqrtTwo) (Cyc.ofDOmega DOmega.invSqrtTwo)\n      = Cyc.ofDOmega DOmega.half := by rfl\n\n/-- The tower map: a level-`k` element lifts to level `k+1` on the even powers,\nand the generator lands on `z^2` as `zeta_{2^k} = zeta_{2^(k+1)}^2` demands. -/\ntheorem cyc_lift_generator : Cyc.lift (Cyc.zetaPow 4 1) = Cyc.zetaPow 8 2 := by rfl\n\n/-- ANTIBODY: distinct powers stay distinct, so the equalities above are not an\nartefact of everything collapsing to one value. -/\ntheorem cyc_zeta_pow_distinct : Cyc.zetaPow 4 1 ≠ Cyc.zetaPow 4 2 := by decide\n\n/-- ANTIBODY: the wrap is a SIGN flip, not a plain rotation. -/\ntheorem cyc_wrap_is_signed : Cyc.zetaPow 4 5 ≠ Cyc.zetaPow 4 1 := by decide\n\n#print axioms cyc_zeta_pow_half\n#print axioms cyc_omega_is_generator\n#print axioms cyc_mul_agrees_wraparound\n#print axioms cyc_add_agrees\n#print axioms cyc_invSqrtTwo_sq\n#print axioms cyc_lift_generator\n#print axioms cyc_zeta_pow_distinct\n#print axioms cyc_wrap_is_signed\n\n\n\n/-! Anchors: the rotation family must reproduce the gates it generalises. -/\n\n/-- `phaseGate` at `z^2` on the `half = 4` level is exactly the `S` gate. -/\ntheorem cyc_phase_two_is_s :\n    Cyc.phaseGate 4 2\n      = (Cyc.ofDOmega DOmega.one, Cyc.ofDOmega DOmega.zero,\n         Cyc.ofDOmega DOmega.zero, Cyc.ofDOmega DOmega.I) := by rfl\n\n/-- `phaseGate` at `z^1` on the `half = 4` level is exactly the `T` gate. -/\ntheorem cyc_phase_one_is_t :\n    Cyc.phaseGate 4 1\n      = (Cyc.ofDOmega DOmega.one, Cyc.ofDOmega DOmega.zero,\n         Cyc.ofDOmega DOmega.zero, Cyc.ofDOmega DOmega.omega) := by rfl\n\n/-- `phaseGate` at `z^4` on the `half = 4` level is exactly the `Z` gate,\nbecause `z^4 = -1`. -/\ntheorem cyc_phase_four_is_z :\n    Cyc.phaseGate 4 4\n      = (Cyc.ofDOmega DOmega.one, Cyc.ofDOmega DOmega.zero,\n         Cyc.ofDOmega DOmega.zero, Cyc.ofDOmega (DOmega.neg DOmega.one)) := by rfl\n\n/-- `Rzk` inverse really is the inverse phase: `z^(2h-1) * z^1 = 1`. -/\ntheorem cyc_rzk_inverse_cancels :\n    Cyc.mul (Cyc.zetaPow 4 7) (Cyc.zetaPow 4 1) = Cyc.one 4 := by rfl\n\n/-- ANTIBODY: the phase family is not constant — different levels differ. -/\ntheorem cyc_phase_levels_distinct : Cyc.phaseGate 4 1 ≠ Cyc.phaseGate 4 2 := by decide\n\n/-- ANTIBODY: `Rzk` and its inverse are genuinely different gates. -/\ntheorem cyc_rzk_inverse_differs : Cyc.rzkGate 4 false ≠ Cyc.rzkGate 4 true := by decide\n\n/-- `cos^2 + sin^2 = 1` in the carrier: the rotation family is on the circle. -/\ntheorem cyc_pythagoras :\n    Cyc.add (Cyc.mul (Cyc.cosPi 4 1) (Cyc.cosPi 4 1))\n        (Cyc.mul (Cyc.sinPi 4 1) (Cyc.sinPi 4 1))\n      = Cyc.one 4 := by rfl\n\n/-- `cos(0) = 1`: the rotation at angle zero is the identity on the cosine. -/\ntheorem cyc_cos_zero : Cyc.cosPi 4 0 = Cyc.one 4 := by rfl\n\n/-- `sin(0) = 0`. -/\ntheorem cyc_sin_zero : Cyc.sinPi 4 0 = Cyc.zero 4 := by rfl\n\n/-- `Ry` at angle zero is the identity matrix. -/\ntheorem cyc_ry_zero_is_identity :\n    Cyc.ryGate 4 0 = (Cyc.one 4, Cyc.zero 4, Cyc.zero 4, Cyc.one 4) := by rfl\n\n/-- ANTIBODY: `Ry` is not constant in its angle. -/\ntheorem cyc_ry_nonconstant : Cyc.ryGate 4 0 ≠ Cyc.ryGate 4 1 := by decide\n\n/-- ANTIBODY: `Rx` and `Ry` are different rotations. -/\ntheorem cyc_rx_ne_ry : Cyc.rxGate 4 1 ≠ Cyc.ryGate 4 1 := by decide\n\n/-- Pythagoras at a NON-degenerate point.  At `e = 1` on this level\n`cos = sin = sqrt2/2`, so a bug that swapped or equated them would still satisfy\n`cyc_pythagoras`.  At `e = 2` they are maximally different (`0` and `1`), so this\nis the test that actually separates them. -/\ntheorem cyc_pythagoras_nondegenerate :\n    Cyc.add (Cyc.mul (Cyc.cosPi 4 2) (Cyc.cosPi 4 2))\n        (Cyc.mul (Cyc.sinPi 4 2) (Cyc.sinPi 4 2))\n      = Cyc.one 4 := by rfl\n\n/-- `cos(pi/2) = 0`. -/\ntheorem cyc_cos_half_pi : Cyc.cosPi 4 2 = Cyc.zero 4 := by rfl\n\n/-- `sin(pi/2) = +1`, NOT `-1`.  This is the only theorem here that pins the\nHANDEDNESS of the rotation family: `cos^2 + sin^2 = 1` is satisfied identically\nby `sin` and by `-sin`, so without this every rotation could be mirrored and\nnothing above would notice. -/\ntheorem cyc_sin_half_pi_is_positive_one : Cyc.sinPi 4 2 = Cyc.one 4 := by rfl\n\n/-- ANTIBODY for the same: `sin(pi/2)` is not `-1`. -/\ntheorem cyc_sin_half_pi_ne_neg_one : Cyc.sinPi 4 2 ≠ Cyc.neg (Cyc.one 4) := by decide\n\n/-- `cos` and `sin` are genuinely different functions, not one relabelled. -/\ntheorem cyc_cos_ne_sin_somewhere : Cyc.cosPi 4 2 ≠ Cyc.sinPi 4 2 := by decide\n\n/-- `Rz` and `phaseGate` differ: they are not interchangeable spellings. -/\ntheorem cyc_rz_ne_phase : Cyc.rzGate 4 1 ≠ Cyc.phaseGate 4 1 := by decide\n\n/-- Canonicity: `normalize` is idempotent, so `decide` compares VALUES and not\nincidental spellings.  Every equality theorem in this section depends on it. -/\ntheorem cyc_normalize_idempotent :\n    Cyc.normalize 4 [2, 4, 0, 0] 1 = Cyc.normalize 4 [1, 2, 0, 0] 0 := by rfl\n\n#print axioms cyc_pythagoras_nondegenerate\n#print axioms cyc_cos_half_pi\n#print axioms cyc_sin_half_pi_is_positive_one\n#print axioms cyc_sin_half_pi_ne_neg_one\n#print axioms cyc_cos_ne_sin_somewhere\n#print axioms cyc_rz_ne_phase\n#print axioms cyc_normalize_idempotent\n#print axioms cyc_pythagoras\n#print axioms cyc_cos_zero\n#print axioms cyc_ry_zero_is_identity\n#print axioms cyc_ry_nonconstant\n#print axioms cyc_rx_ne_ry\n#print axioms cyc_phase_two_is_s\n#print axioms cyc_phase_one_is_t\n#print axioms cyc_phase_four_is_z\n#print axioms cyc_rzk_inverse_cancels\n#print axioms cyc_phase_levels_distinct\n#print axioms cyc_rzk_inverse_differs\n\n/-! ### The downcast closes the drift seam\n\n`DOmega = Z[1/sqrt 2, i] = Z[1/2, zeta_8]` IS the level-8 cyclotomic ring, so a\nlevel-8 rotation is not merely convertible to a Clifford+T gate — it is one.\nHad `localGate` answered `none` for every `rot`, `rot phase 4 1 false` and `T`\nwould be one mathematical gate with two spellings and divergent semantics.\nThese theorems are what forbid that, and the refutations keep the agreement from\nbeing an artefact of a collapsed equality. -/\n\n/-- `rot phase 4 1` IS `T`, not merely equivalent to it. -/\ntheorem rot_phase_is_T :\n    localGate (.rot .phase 4 1 false) = localGate .T := by decide\n\n/-- `rot phase 4 2` IS `S`. -/\ntheorem rot_phase_is_S :\n    localGate (.rot .phase 4 2 false) = localGate .S := by decide\n\n/-- `rot phase 4 4` IS `Z`, via the defining relation `z^4 = -1`. -/\ntheorem rot_phase_is_Z :\n    localGate (.rot .phase 4 4 false) = localGate .Z := by decide\n\n/-- `rot phase 4 7` IS `Tdg`, so the inverse branch lands too. -/\ntheorem rot_phase_is_Tdg :\n    localGate (.rot .phase 4 7 false) = localGate .Tdg := by decide\n\n/-- The TOWER, exercised: at `half = 2` the generator is `zeta_4 = i`, and the\nsingle `lift` puts `diag(1, i)` back on `S`. -/\ntheorem rot_level_four_lifts_to_S :\n    localGate (.rot .phase 2 1 false) = localGate .S := by decide\n\n/-- Two lifts: at `half = 1` the generator is `zeta_2 = -1`, giving `Z`. -/\ntheorem rot_level_two_lifts_to_Z :\n    localGate (.rot .phase 1 1 false) = localGate .Z := by decide\n\n/-- A non-diagonal axis downcasts too: `cos(pi/4) = 1/sqrt 2` is in `DOmega`. -/\ntheorem rot_ry_downcasts : (localGate (.rot .ry 4 1 false)).isSome = true := by decide\n\n/-! The `none` answers, each true for a DIFFERENT reason. -/\n\n/-- Level 16 (`half = 8`) genuinely leaves `DOmega`: `zeta_16` is not in\n`Z[1/2, zeta_8]`.  This fence is honest, not a shortcut. -/\ntheorem rot_level_sixteen_escapes_domega :\n    localGate (.rot .phase 8 1 false) = none := by decide\n\n/-- `half = 3` is not a cyclotomic level at all: `x^3 + 1` factors, so\n`Z[x]/(x^3+1)` is not a domain.  Rejected for a structural reason. -/\ntheorem rot_noncyclotomic_level_rejected :\n    localGate (.rot .phase 3 1 false) = none := by decide\n\n/-- A CONTROLLED rotation has no single-qubit local matrix, exactly as `CY` and\n`CH` do not; `applyGate` is where control is interpreted. -/\ntheorem rot_controlled_has_no_local_matrix :\n    localGate (.rot .phase 4 1 true) = none := by decide\n\n/-! Refutations: the agreements above are not a collapse. -/\n\ntheorem rot_phase_one_ne_S : localGate (.rot .phase 4 1 false) ≠ localGate .S := by decide\ntheorem rot_phase_two_ne_T : localGate (.rot .phase 4 2 false) ≠ localGate .T := by decide\n\n/-- The sign trap, pinned at the level where both are defined: `Rz = diag(z^-e,\nz^e)` differs from `phase = diag(1, z^e)` by the global phase `z^-e`, which\nbecomes observable under control. -/\ntheorem rot_rz_ne_phase_downcast :\n    localGate (.rot .rz 4 1 false) ≠ localGate (.rot .phase 4 1 false) := by decide\n\n/-- `Rx` and `Ry` are genuinely different axes after the downcast. -/\ntheorem rot_rx_ne_ry_downcast :\n    localGate (.rot .rx 4 1 false) ≠ localGate (.rot .ry 4 1 false) := by decide\n\n#print axioms rot_phase_is_T\n#print axioms rot_level_two_lifts_to_Z\n#print axioms rot_level_sixteen_escapes_domega\n#print axioms rot_rz_ne_phase_downcast\n#print axioms h_unitary\n\n/-! ### Controlled rotations must actually act\n\n`Crk`/`Cry` have no single-qubit local matrix, so they reach `applyGate`'s\nfallback.  Before these theorems that fallback silently returned the input,\nmaking every controlled rotation a very convincing identity gate. -/\n\n/-- `|11>`, the state where a control on qubit 0 is set. -/\ndef ketOneOne : ExactVector :=\n  makeVector 4 fun r => if r == 3 then DOmega.one else DOmega.zero\n\n/-- Controlled-`phase(z^4) = Z` must flip the sign of `|11>`: it is NOT the\nidentity.  This is the antibody that catches the fallthrough. -/\ntheorem crk_is_not_the_identity :\n    applyGate (.rot .phase 4 4 true) 0 1 ketOneOne ≠ ketOneOne := by decide\n\n/-- ...and it must leave the control-unset subspace alone. -/\ntheorem crk_acts_only_where_control_is_set :\n    applyGate (.rot .phase 4 4 true) 0 1\n      (makeVector 4 fun r => if r == 1 then DOmega.one else DOmega.zero)\n      = makeVector 4 fun r => if r == 1 then DOmega.one else DOmega.zero := by decide\n\n/-- The controlled gate is genuinely the control of ITS OWN matrix: controlled-T\nand controlled-Z differ on `|11>`. -/\ntheorem crk_distinguishes_its_angle :\n    applyGate (.rot .phase 4 1 true) 0 1 ketOneOne\n      ≠ applyGate (.rot .phase 4 4 true) 0 1 ketOneOne := by decide\n\n/-! ### Checked frontier antibodies\n\nThese are deliberately about the result constructor, not merely a changed\namplitude.  They prevent a future refactor from laundering an unsupported\nrotation, measurement, or reset into a successful identity state.\n-/\n\ntheorem unsupported_half_eight_is_typed_obstruction :\n    match applyGateChecked 7 (.rot .phase 8 1 false) 0 0\n        (basisVector 2 0) with\n    | .error receipt =>\n        receipt.failure = .unsupportedRotationCarrier .phase 8 1 false ∧\n        receipt.continuation = .widerCyclotomicCarrier 16 ∧\n        receipt.operationIndex = 7 ∧ receipt.stateDimension = 2\n    | .ok _ => False := by\n  have downcast : rotationDOmegaBlock? .phase 8 1 = none := by decide\n  have rootOrder : rotationCarrierRootOrder .phase 8 1 = 16 := by decide\n  simp [applyGateChecked, rotationExecutionFailureReceipt, downcast,\n    rootOrder, basisVector, makeVector]\n\ntheorem malformed_zero_half_is_not_a_carrier_request :\n    match applyGateChecked 3 (.rot .rz 0 1 true) 0 1 (basisVector 4 0) with\n    | .error receipt =>\n        receipt.failure = .invalidRotationDenominator .rz 1 true ∧\n        receipt.continuation = .rejectMalformedInput\n    | .ok _ => False := by\n  simp [applyGateChecked, rotationExecutionFailureReceipt]\n\ntheorem measurement_is_not_unitary_identity :\n    match applyUnitaryOpChecked 2 (.measure .Z 0 0) (basisVector 2 0) with\n    | .error receipt =>\n        receipt.failure = .measurementInUnitaryPath .Z 0 0 ∧\n        receipt.continuation = .instrumentSemantics\n    | .ok _ => False := by\n  simp [applyUnitaryOpChecked]\n\ntheorem unsupported_half_eight_is_not_domega_admissible :\n    exactGateCarrierAdmissible (.rot .phase 8 1 false) = false := by\n  have downcast : rotationDOmegaBlock? .phase 8 1 = none := by decide\n  simp [exactGateCarrierAdmissible, downcast]\n\ntheorem supported_rotation_checked_agrees :\n    applyGateChecked 0 (.rot .phase 4 1 false) 0 0 (basisVector 2 1) =\n      .ok (applyGate (.rot .phase 4 1 false) 0 0 (basisVector 2 1)) := by rfl\n\ntheorem rotation_root_order_reduces_common_factor :\n    rotationRootOrder 12 2 = 12 := by decide\n\ntheorem ry_wider_carrier_adjoins_quadrature_root :\n    rotationCarrierRootOrder .ry 3 1 = 12 := by decide\n\ntheorem phase_wider_carrier_needs_only_reduced_phase_root :\n    rotationCarrierRootOrder .phase 3 1 = 6 := by decide\n\n/-- A redundant high-level spelling whose actual phase is `T` stays inside the\nexisting exact carrier instead of being needlessly routed outward. -/\ntheorem reducible_half_eight_phase_executes_as_t :\n    applyGateChecked 0 (.rot .phase 8 2 false) 0 0 (basisVector 2 1) =\n      .ok (applyGate .T 0 0 (basisVector 2 1)) := by rfl\n\ntheorem reducible_half_eight_phase_is_domega_admissible :\n    exactGateCarrierAdmissible (.rot .phase 8 2 false) = true := by decide\n\n#print axioms crk_is_not_the_identity\n#print axioms crk_acts_only_where_control_is_set\n#print axioms crk_distinguishes_its_angle\n#print axioms unsupported_half_eight_is_typed_obstruction\n#print axioms malformed_zero_half_is_not_a_carrier_request\n#print axioms measurement_is_not_unitary_identity\n#print axioms unsupported_half_eight_is_not_domega_admissible\n#print axioms supported_rotation_checked_agrees\n#print axioms rotation_root_order_reduces_common_factor\n#print axioms ry_wider_carrier_adjoins_quadrature_root\n#print axioms phase_wider_carrier_needs_only_reduced_phase_root\n#print axioms reducible_half_eight_phase_executes_as_t\n#print axioms reducible_half_eight_phase_is_domega_admissible\n#print axioms applyGateChecked_success\n#print axioms applyUnitaryOpChecked_success\n#print axioms runUnitaryStateChecked_success\n\nend HeytingLean.Quantum.ProofCarrying\n","media_type":"text/x-lean","path":"environment/local/HeytingLean/Quantum/ProofCarrying/ExactCliffordTMeasurement.lean","sha256":"0c662efb8d4ca7fa38849a81e2adfb9554e2efef304840f23c8a4fb61954ad70"},{"byte_length":5271,"content":"import HeytingLean.Quantum.ProofCarrying.ExactCliffordTMeasurement\n\nnamespace Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372\n\nopen HeytingLean.Quantum.ProofCarrying\n\ndef circuitSubjectSha256 : String :=\n  \"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a\"\n\ndef sourceOperationIds : List String :=\n  [\"g0\", \"g1\", \"g2\", \"g3\", \"g4\", \"g5\", \"g6\", \"g7\", \"g8\", \"g9\", \"g10\", \"g11\", \"g12\", \"g13\", \"g14\", \"g15\", \"g16\", \"g17\", \"g18\", \"g19\", \"g20\", \"g21\", \"g22\", \"g23\", \"g24\", \"g25\", \"g26\", \"g27\", \"g28\", \"g29\", \"g30\", \"g31\", \"g32\", \"g33\", \"g34\", \"g35\", \"g36\", \"g37\", \"g38\", \"g39\", \"g40\", \"g41\", \"g42\", \"g43\", \"g44\", \"g45\", \"g46\"]\n\ndef sourceCircuit : List ExactOp :=\n  [.gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .S 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .S 0 0, .gate .T 0 0, .gate .H 0 0, .gate .Z 0 0, .gate .T 0 0, .gate .H 0 0, .gate .Z 0 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .Sdg 1 0, .gate .CX 0 1, .gate .S 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .S 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .S 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .Sdg 1 0, .gate .CX 0 1]\n\ndef expectedExactAction : ExactMatrix :=\n  [[HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨-13, 23, -7, -9⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨1, 23, 11, -21⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨17, -17, -1, -1⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨23, -13, -27, -13⟩ 6], [HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨31, 35, -3, -1⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨1, -25, 11, -1⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨-7, -1, 19, -9⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨-5, 15, -19, 7⟩ 6], [HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨-1, -1, -17, 17⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨-27, -13, -23, 13⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨9, 7, -23, 13⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨3, 11, -29, -11⟩ 6], [HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨9, 13, -11, 11⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨7, -19, 15, -5⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨15, -11, -41, -13⟩ 6, HeytingLean.Quantum.ProofCarrying.DOmega.normalize ⟨1, -11, 25, -1⟩ 6]]\n\ndef claimSha256_r3p00_ct_prep_well_formed : String :=\n  \"1414bed2ec0b4b46d728358ef6e0e78ccd98fb64e685cd2936f2426477077369\"\n\ntheorem claim_r3p00_ct_prep_well_formed :\n    circuitSubjectSha256 = \"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a\" ∧\n      claimSha256_r3p00_ct_prep_well_formed = \"1414bed2ec0b4b46d728358ef6e0e78ccd98fb64e685cd2936f2426477077369\" ∧\n      sourceOperationIds = [\"g0\", \"g1\", \"g2\", \"g3\", \"g4\", \"g5\", \"g6\", \"g7\", \"g8\", \"g9\", \"g10\", \"g11\", \"g12\", \"g13\", \"g14\", \"g15\", \"g16\", \"g17\", \"g18\", \"g19\", \"g20\", \"g21\", \"g22\", \"g23\", \"g24\", \"g25\", \"g26\", \"g27\", \"g28\", \"g29\", \"g30\", \"g31\", \"g32\", \"g33\", \"g34\", \"g35\", \"g36\", \"g37\", \"g38\", \"g39\", \"g40\", \"g41\", \"g42\", \"g43\", \"g44\", \"g45\", \"g46\"] ∧\n      sourceCircuit = [.gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .S 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .T 0 0, .gate .H 0 0, .gate .S 0 0, .gate .T 0 0, .gate .H 0 0, .gate .Z 0 0, .gate .T 0 0, .gate .H 0 0, .gate .Z 0 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .Sdg 1 0, .gate .CX 0 1, .gate .S 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .S 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .S 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .T 1 0, .gate .H 1 0, .gate .Sdg 1 0, .gate .CX 0 1] := by\n  constructor\n  · rfl\n  constructor\n  · rfl\n  constructor\n  · rfl\n  · rfl\n\ndef claimSha256_r3p00_ct_prep_action : String :=\n  \"c5e1bd8e4bdcef6ebc06cdefc53d0dbe5585063272963a608583e2ec1f2f9f6d\"\n\nset_option maxRecDepth 65536 in\nset_option maxHeartbeats 20000000 in\ntheorem claim_r3p00_ct_prep_action :\n    circuitSubjectSha256 = \"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a\" ∧\n      claimSha256_r3p00_ct_prep_action = \"c5e1bd8e4bdcef6ebc06cdefc53d0dbe5585063272963a608583e2ec1f2f9f6d\" ∧\n      unitaryMatrix 2 sourceCircuit = expectedExactAction ∧\n      unitaryInvariant 2 sourceCircuit = true := by\n  constructor\n  · rfl\n  constructor\n  · rfl\n  constructor\n  · decide\n  · decide\n\ntheorem anti_vacuity_t_ne_tdg :\n    unitaryMatrix 1 [.gate .T 0 0] ≠ unitaryMatrix 1 [.gate .Tdg 0 0] := by decide\n\ntheorem anti_vacuity_measurement_changes_instrument :\n    runInstrument 1 1 [.gate .H 0 0, .measure .Z 0 0] ≠\n      runInstrument 1 1 [.gate .H 0 0] := by decide\n\n#print axioms claim_r3p00_ct_prep_well_formed\n#print axioms claim_r3p00_ct_prep_action\n#print axioms anti_vacuity_t_ne_tdg\n#print axioms anti_vacuity_measurement_changes_instrument\n\nend Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372\n","media_type":"text/x-lean","path":"proof/Generated.lean","sha256":"1f80c9a90c7030f529681137aefb487ec8a9b551d3c4dbcbb9146b5cdda74f48"},{"byte_length":911,"content":"{\"dependency_manifest_sha256\":\"e87a77dcb0890f02235d37157143a36e24e321c5da103886dfa37c0d75359f10\",\"lean_version\":\"Lean (version 4.24.0, x86_64-unknown-linux-gnu, commit 797c613eb9b6d4ec95db23e3e00af9ac6657f24b, Release)\",\"schema\":\"heyting.quantum_lean_axiom_probe.v1\",\"source_sha256\":\"1f80c9a90c7030f529681137aefb487ec8a9b551d3c4dbcbb9146b5cdda74f48\",\"status\":\"kernel_clean\",\"stdout_sha256\":\"a1eeb778c765b6d2b17218a020547eff79dbcadb61f6cbfda79f9e2777808046\",\"theorems\":[{\"axioms\":[],\"theorem\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372.claim_r3p00_ct_prep_well_formed\"},{\"axioms\":[],\"theorem\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372.claim_r3p00_ct_prep_action\"},{\"axioms\":[],\"theorem\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372.anti_vacuity_t_ne_tdg\"},{\"axioms\":[],\"theorem\":\"Generated.ProofCarryingQuantum.CertCf3f0c674daa1a372.anti_vacuity_measurement_changes_instrument\"}]}","media_type":"application/json","path":"proof/axiom_probe.json","sha256":"55565378188c9544067acbd3d4e8037cdf1255ec038bb19a65636dfe4e93cc04"},{"byte_length":974,"content":"{\"compiled_objects\":[{\"byte_length\":2646744,\"module\":\"HeytingLean.Quantum.ProofCarrying.ExactCliffordTMeasurement\",\"path\":\".lake/build/lib/lean/HeytingLean/Quantum/ProofCarrying/ExactCliffordTMeasurement.olean\",\"sha256\":\"f809e3027df0f8e043b4c03c32b9f56318628d58764565cbb0101e867be64c9c\"}],\"lake_manifest_sha256\":\"e89de7992d512493420ae16c3c309355fab0e12029fbe04a273b44e928cea425\",\"lakefile_sha256\":\"b0d55680dab911c20e4dc7cd013fc2155471a2d6d6bd9afe2c75633d894169e0\",\"lean_toolchain_sha256\":\"42779d67b81608af8a12aa4328d2ab47ca201925b3b2bd68369587b5340bb434\",\"local_sources\":[{\"artifact_path\":\"environment/local/HeytingLean/Quantum/ProofCarrying/ExactCliffordTMeasurement.lean\",\"byte_length\":60239,\"module\":\"HeytingLean.Quantum.ProofCarrying.ExactCliffordTMeasurement\",\"path\":\"HeytingLean/Quantum/ProofCarrying/ExactCliffordTMeasurement.lean\",\"sha256\":\"0c662efb8d4ca7fa38849a81e2adfb9554e2efef304840f23c8a4fb61954ad70\"}],\"schema\":\"heyting.quantum_kernel_dependency_manifest.v1\"}","media_type":"application/json","path":"proof/dependency_manifest.json","sha256":"e87a77dcb0890f02235d37157143a36e24e321c5da103886dfa37c0d75359f10"}],"certificate_id":"qpcert_f3f0c674daa1a372","certified_claim_ids":["r3p00_ct_prep_action","r3p00_ct_prep_well_formed"],"circuit_subject_sha256":"f3f0c674daa1a3720b4d234c751754f2d0a3afac34b85070c780337ae9d4ec0a","requested_claims_sha256":"e2a1b8a7818e99dfc5b4d90f3261eed8e21e7abeb014148cb05bd3426d9fe4bc","schema":"heyting.quantum_proof_certificate.v1","semantic_profile":"exact_clifford_t_v2"}